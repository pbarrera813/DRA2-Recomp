diff --git a/tools/recomp/test_lifter_fcmov.py b/tools/recomp/test_lifter_fcmov.py
new file mode 100644
index 0000000..e2767ad
--- /dev/null
+++ b/tools/recomp/test_lifter_fcmov.py
@@ -0,0 +1,53 @@
+"""FCMOVcc must be a conditional move on the preceding fcomi/fucomi result.
+
+It fell through to the FPU catch-all and became a comment, so the common
+clamp `fucomi st(0),st(2); fcmovb st(0),st(2); fucomi st(0),st(1);
+fcmovnbe st(0),st(1)` returned its input unclamped. In DRA2 that turned a
+centred stick into a constant deflection through the deadzone clamp.
+"""
+import unittest
+
+from .disasm import BasicBlock, Instruction, Operand
+from .lifter import Lifter, lift_basic_block
+
+
+def _st(i):
+    return Operand(type="reg", reg=f"st({i})")
+
+
+def _insn(addr, mnemonic, i):
+    # Capstone gives fucomi only its explicit st(i); fcmov gets both.
+    insn = Instruction(addr, 3, mnemonic, f"st(0), st({i})", "dbf0")
+    insn.operands = [_st(i)] if mnemonic == "fucomi" else [_st(0), _st(i)]
+    return insn
+
+
+def _clamp_block():
+    return BasicBlock(start=0, instructions=[
+        _insn(0, "fucomi", 2), _insn(3, "fcmovb", 2),
+        _insn(6, "fucomi", 1), _insn(9, "fcmovnbe", 1)])
+
+
+class FcmovTest(unittest.TestCase):
+    def test_clamp_is_two_conditional_moves(self):
+        lifted, _ = lift_basic_block(Lifter(), _clamp_block())
+        text = "\n".join(lifted)
+        self.assertNotIn("/* FPU: fcmov", text)
+        # jb on an fcomi result: below or unordered.
+        self.assertIn("RECOMP_FCMP(fp_top(), g_fp_stack[(g_fp_top + 2) & 7])", text)
+        self.assertIn("if ((g_fp_cmp < 0 || g_fp_cmp == 2) /* fucomi */) "
+                      "fp_top() = g_fp_stack[(g_fp_top + 2) & 7];", text)
+        # ja: strictly above.
+        self.assertIn("if ((g_fp_cmp == 1) /* fucomi */) fp_top() = fp_st1();", text)
+
+    def test_every_form_has_a_condition(self):
+        for m in ("fcmovb", "fcmove", "fcmovbe", "fcmovu",
+                  "fcmovnb", "fcmovne", "fcmovnbe", "fcmovnu"):
+            block = BasicBlock(start=0, instructions=[
+                _insn(0, "fucomi", 1), _insn(3, m, 1)])
+            text = "\n".join(lift_basic_block(Lifter(), block)[0])
+            self.assertIn(f"fp_top() = fp_st1(); /* {m}", text, m)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/recomp/test_lifter_fcomi_carry.py b/tools/recomp/test_lifter_fcomi_carry.py
new file mode 100644
index 0000000..a518384
--- /dev/null
+++ b/tools/recomp/test_lifter_fcomi_carry.py
@@ -0,0 +1,39 @@
+"""fcomi/fcomip must set CF for a following adc/sbb, not only g_fp_cmp.
+
+MSVC's floor-to-int idiom is `fld x; fld st0; frndint; fxch; fcomip st,st1;
+fistp [m]; sbb [m], eax` (eax = 0): the sbb subtracts CF = x < round(x). With
+CF left stale the floor became the rounded value, so under the game thread's
+chop rounding every negative non-integer floored one too high (DRA2 has 75 of
+these, among them the item generators' spawn count).
+"""
+import unittest
+
+from .disasm import BasicBlock, Instruction, Operand
+from .lifter import Lifter, lift_basic_block
+
+
+def _fcomip():
+    insn = Instruction(0, 2, "fcomip", "st(0), st(1)", "dff1")
+    insn.operands = [Operand(type="reg", reg="st(1)")]
+    return insn
+
+
+def _lift(needs_cf):
+    lifter = Lifter()
+    lifter.needs_cf = needs_cf
+    return "\n".join(lift_basic_block(lifter, BasicBlock(start=0, instructions=[_fcomip()]))[0])
+
+
+class FcomiCarryTest(unittest.TestCase):
+    def test_sets_carry_before_the_pop(self):
+        text = _lift(True)
+        # CF: below or unordered, taken from the compare before st(0) is popped.
+        self.assertIn("g_fp_cmp = RECOMP_FCMP(fp_top(), fp_st1()); "
+                      "_cf = (g_fp_cmp < 0 || g_fp_cmp == 2); fp_pop();", text)
+
+    def test_no_carry_where_nothing_reads_it(self):
+        self.assertNotIn("_cf", _lift(False))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/recomp/test_lifter_narrow_muldiv.py b/tools/recomp/test_lifter_narrow_muldiv.py
new file mode 100644
index 0000000..97d9adb
--- /dev/null
+++ b/tools/recomp/test_lifter_narrow_muldiv.py
@@ -0,0 +1,119 @@
+"""One-operand MUL/IMUL/DIV/IDIV must honour the operand's width.
+
+The 32-bit form was emitted for every width, so `imul cl` wrote
+EDX:EAX = EAX * CL where x86 writes AX = AL * CL and leaves EDX alone. DRA2's
+DirectSound cipher reads DL straight after `imul cl` and produced wrong bytes.
+
+The sweep compiles the lifter's own statement and compares EAX and EDX with an
+x86 reference over value pairs chosen to exercise sign, high bytes and the
+untouched upper halves. The negative control runs the old 32-bit expression
+for the 8-bit `imul` and requires the sweep to catch it.
+"""
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+import pytest
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+
+_PRELUDE = r'''#include <stdint.h>
+#include <stdio.h>
+static uint32_t eax, edx, ecx;
+static uint32_t _fa; static int32_t _fas;
+#define LO8(r)  ((uint8_t)(r))
+#define LO16(r) ((uint16_t)((r) & 0xFFFF))
+#define SET_LO16(r, v) ((r) = ((r) & 0xFFFF0000u) | ((uint32_t)(uint16_t)(v)))
+'''
+
+# x86 semantics, written independently of the lifter.
+_REFERENCE = {
+    ("mul", 1):  "uint16_t r = (uint16_t)((uint8_t)a * (uint8_t)c); *pa = (a & 0xFFFF0000u) | r;",
+    ("imul", 1): "uint16_t r = (uint16_t)((int8_t)a * (int8_t)c); *pa = (a & 0xFFFF0000u) | r;",
+    ("div", 1):  "uint16_t n = (uint16_t)a; uint8_t d = (uint8_t)c; if (n / d > 0xFF) return 0;"
+                 " *pa = (a & 0xFFFF0000u) | ((n % d) << 8) | (n / d);",
+    ("idiv", 1): "int16_t n = (int16_t)a; int8_t d = (int8_t)c; int q = n / d; if (q > 127 || q < -128) return 0;"
+                 " *pa = (a & 0xFFFF0000u) | ((uint8_t)(n % d) << 8) | (uint8_t)q;",
+    ("mul", 2):  "uint32_t r = (uint32_t)((uint16_t)a * (uint16_t)c);"
+                 " *pa = (a & 0xFFFF0000u) | (r & 0xFFFF); *pd = (d0 & 0xFFFF0000u) | (r >> 16);",
+    ("imul", 2): "uint32_t r = (uint32_t)((int16_t)a * (int16_t)c);"
+                 " *pa = (a & 0xFFFF0000u) | (r & 0xFFFF); *pd = (d0 & 0xFFFF0000u) | (r >> 16);",
+    ("div", 2):  "uint32_t n = ((d0 & 0xFFFF) << 16) | (a & 0xFFFF); uint16_t d = (uint16_t)c;"
+                 " if (n / d > 0xFFFF) return 0;"
+                 " *pa = (a & 0xFFFF0000u) | (n / d); *pd = (d0 & 0xFFFF0000u) | (n % d);",
+    ("idiv", 2): "int32_t n = (int32_t)(((d0 & 0xFFFF) << 16) | (a & 0xFFFF)); int16_t d = (int16_t)c;"
+                 " int32_t q = n / d; if (q > 32767 || q < -32768) return 0;"
+                 " *pa = (a & 0xFFFF0000u) | (uint16_t)q; *pd = (d0 & 0xFFFF0000u) | (uint16_t)(n % d);",
+}
+
+_OLD_IMUL8 = ("{ int64_t _r = (int64_t)(int32_t)eax * (int64_t)(int32_t)LO8(ecx);"
+              " eax = (uint32_t)_r; edx = (uint32_t)(_r >> 32); }")
+
+
+def _emitted(mnemonic, width):
+    reg = {1: "cl", 2: "cx"}[width]
+    insn = Instruction(0, 2, mnemonic, reg, "", operands=[Operand(type="reg", reg=reg)])
+    return " ".join(Lifter().lift_instruction(insn))
+
+
+def _source(mnemonic, width, body):
+    return _PRELUDE + r'''
+static int reference(uint32_t a, uint32_t d0, uint32_t c, uint32_t *pa, uint32_t *pd)
+{
+    if (((c & %(mask)s) == 0)) return 0;   /* #DE: not a lowering question */
+    *pa = a; *pd = d0;
+    { %(ref)s }
+    return 1;
+}
+
+int main(void)
+{
+    static const uint32_t v[] = { 0x00000000u, 0x00000001u, 0x0000007Fu, 0x00000080u,
+        0x000000FFu, 0x00001234u, 0x0000FFFFu, 0xDEAD8001u, 0x12345678u, 0xFFFFFFFFu };
+    int failures = 0, checked = 0;
+    for (unsigned i = 0; i < sizeof v / sizeof v[0]; i++)
+        for (unsigned j = 0; j < sizeof v / sizeof v[0]; j++)
+            for (unsigned k = 0; k < sizeof v / sizeof v[0]; k++) {
+                uint32_t wa, wd;
+                if (!reference(v[i], v[j], v[k], &wa, &wd)) continue;
+                eax = v[i]; edx = v[j]; ecx = v[k];
+                %(body)s
+                checked++;
+                if (eax != wa || edx != wd) {
+                    if (++failures <= 8)
+                        printf("a=%%08X d=%%08X c=%%08X got %%08X:%%08X want %%08X:%%08X\n",
+                               v[i], v[j], v[k], edx, eax, wd, wa);
+                }
+            }
+    printf("checked %%d\n", checked);
+    return failures ? 1 : 0;
+}
+''' % dict(mask="0xFFu" if width == 1 else "0xFFFFu", ref=_REFERENCE[(mnemonic, width)], body=body)
+
+
+def _build_and_run(source):
+    cc = shutil.which("clang") or shutil.which("gcc")
+    if not cc and Path(r"C:\Program Files\LLVM\bin\clang.exe").exists():
+        cc = r"C:\Program Files\LLVM\bin\clang.exe"
+    if not cc:
+        pytest.skip("C compiler unavailable")
+    with tempfile.TemporaryDirectory() as temp:
+        src = Path(temp) / "test.c"
+        src.write_text(source)
+        exe = Path(temp) / "test.exe"
+        built = subprocess.run([cc, str(src), "-o", str(exe)], capture_output=True, text=True)
+        assert built.returncode == 0, built.stderr
+        return subprocess.run([str(exe)], capture_output=True, text=True)
+
+
+@pytest.mark.parametrize("mnemonic,width", sorted(_REFERENCE))
+def test_matches_x86(mnemonic, width):
+    ran = _build_and_run(_source(mnemonic, width, _emitted(mnemonic, width)))
+    assert ran.returncode == 0, ran.stdout + ran.stderr
+
+
+def test_negative_control_the_old_imul8_is_caught():
+    ran = _build_and_run(_source("imul", 1, _OLD_IMUL8))
+    assert ran.returncode == 1, ran.stdout + ran.stderr
