diff --git a/tests/pb_scan/pb_split_test.c b/tests/pb_scan/pb_split_test.c
new file mode 100644
index 0000000..9d8e6ac
--- /dev/null
+++ b/tests/pb_scan/pb_split_test.c
@@ -0,0 +1,73 @@
+// A packet cut by DMA_PUT continues in the next segment, as on the NV2A
+// pusher; a segment starting elsewhere drops it; a ring wrap resumes at the
+// JUMP's target.
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+void nv2a_pb_scan(uint32_t start_va, uint32_t end_va);
+void nv2a_pb_scan_wrap(uint32_t last_put_va, uint32_t put_va);
+
+static uint32_t s_ring[64];
+static uint32_t s_m[64], s_p[64];
+static int s_n;
+
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)s_ring - (ptrdiff_t)0x80000000u; }
+void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param)
+{
+    (void)subch;
+    if (s_n < 64) { s_m[s_n] = method; s_p[s_n] = param; s_n++; }
+}
+void nv2a_pb_exec_report(void) {}
+
+#define VA(i) (0x80000000u + (uint32_t)(i) * 4u)
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { fails++; printf("FAIL: " __VA_ARGS__); printf("\n"); } } while (0)
+
+int main(void)
+{
+    int i;
+    _putenv("RECOMP_PB_EXEC=1");
+
+    // Increasing: 0x0B00 x4, cut after two data words.
+    s_ring[0] = (4u << 18) | 0x0B00u;
+    for (i = 0; i < 4; i++) s_ring[1 + i] = 0x100u + (uint32_t)i;
+    s_ring[5] = (1u << 18) | 0x1E9Cu; s_ring[6] = 7;          // a following packet
+    nv2a_pb_scan(VA(0), VA(3));
+    nv2a_pb_scan(VA(3), VA(7));
+    CHECK(s_n == 5, "split increasing packet delivered %d methods (want 5)", s_n);
+    for (i = 0; i < 4 && i < s_n; i++)
+        CHECK(s_m[i] == 0x0B00u + (uint32_t)i * 4 && s_p[i] == 0x100u + (uint32_t)i,
+              "word %d went to 0x%04X = 0x%X", i, s_m[i], s_p[i]);
+    CHECK(s_n == 5 && s_m[4] == 0x1E9Cu && s_p[4] == 7, "the next header was not read as a header");
+
+    // Non-increasing: 0x1818 x3, cut after one data word.
+    s_n = 0;
+    s_ring[10] = 0x40000000u | (3u << 18) | 0x1818u;
+    s_ring[11] = 1; s_ring[12] = 2; s_ring[13] = 3;
+    nv2a_pb_scan(VA(10), VA(12));
+    nv2a_pb_scan(VA(12), VA(14));
+    CHECK(s_n == 3 && s_m[0] == 0x1818u && s_m[1] == 0x1818u && s_m[2] == 0x1818u && s_p[2] == 3,
+          "split non-increasing packet: %d methods, last 0x%04X", s_n, s_n ? s_m[s_n - 1] : 0);
+
+    // Cut, then a segment elsewhere: the pending words are not invented.
+    s_n = 0;
+    s_ring[20] = (4u << 18) | 0x0B00u;
+    s_ring[30] = (1u << 18) | 0x1EA0u; s_ring[31] = 0;
+    nv2a_pb_scan(VA(20), VA(22));
+    nv2a_pb_scan(VA(30), VA(32));
+    CHECK(s_n == 2 && s_m[1] == 0x1EA0u, "a non-contiguous segment continued the old packet (%d methods)", s_n);
+
+    // Wrap: the commands up to the title's JUMP count, then the JUMP's target.
+    s_n = 0;
+    s_ring[40] = (1u << 18) | 0x1EA4u; s_ring[41] = 9;        // ring start
+    s_ring[50] = (1u << 18) | 0x1E9Cu; s_ring[51] = 5;        // after the last PUT
+    s_ring[52] = (40u * 4u) | 1u;                             // JUMP to the ring start
+    nv2a_pb_scan_wrap(VA(50), VA(42));
+    CHECK(s_n == 2 && s_m[0] == 0x1E9Cu && s_p[0] == 5 && s_m[1] == 0x1EA4u && s_p[1] == 9,
+          "wrap delivered %d methods (want 0x1E9C then 0x1EA4)", s_n);
+
+    printf(fails ? "%d check(s) failed\n" : "all checks passed\n", fails);
+    return fails ? 1 : 0;
+}
