-                                      requested_num - sample_count);
-        if (count < 0) break;
-        if (count == 0) return -1;
-        sample_count += count;
+    float step = rate > 0.0f ? 1.0f / rate : 1.0f;
+    int out = 0;
+
+    if (voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
+                       NV_PAVS_VOICE_PAR_STATE_NEW_VOICE)) {
+        g_rs[v].head = g_rs[v].n = 0;
+        g_rs[v].pos = 0.0f;
     }
-    (void)rate; /* Ignored until we add proper resampling */
-    return sample_count;
+    while (out < requested_num) {
+        while (g_rs[v].pos >= 1.0f && g_rs[v].n > 1) {
+            g_rs[v].head = (g_rs[v].head + 1) % RS_LEN;
+            g_rs[v].n--;
+            g_rs[v].pos -= 1.0f;
+        }
+        if (g_rs[v].n < 2 || g_rs[v].pos >= 1.0f) {
+            int active = voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
+                                        NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE);
+            if (!active) {
