+// D3D11 rasteriser (RECOMP_GPU=1): the executor transforms and clips on the
+// CPU; this draws the triangles at RECOMP_GPU_SCALE.
+#ifndef NV2A_GPU_H
+#define NV2A_GPU_H
+
+#include <stdint.h>
+#include "nv2a_combiner.h"
+
+typedef struct {
+    void    *tex;                          // nv2a_gpu_texture handle, NULL = white
+    int      cube;
+    float    uscale, vscale;               // 1 for normalised formats, 1/size for linear
+    uint32_t wrap_u, wrap_v, linear;       // address modes (1 = wrap), bilinear
+} Nv2aGpuStage;
+
+typedef struct {
+    float    width, height, zmax;          // logical surface, depth units
+    uint32_t clip_x, clip_y, clip_w, clip_h;
+    uint32_t depth_test, depth_func, depth_mask;
+    uint32_t blend_enable, blend_sfactor, blend_dfactor, blend_equation, blend_color;
+    uint32_t color_mask, alpha_test, alpha_func, alpha_ref;
+    uint32_t cull_enable, cull_face, front_face;   // NV097 values
+    int      use_rc;                       // register combiners, else d0 * stage 0
+    Nv2aCombiner rc;
+    uint32_t clip_plane_mode, fog_enable, fog_mode;
+    float    fog_param[2], fog_rgb[3];
+    Nv2aGpuStage st[4];
+} Nv2aGpuState;
+
+int  nv2a_gpu_on(void);                    // RECOMP_GPU set and device up
+// verts: n vertices laid out as Nv2aVshOutput (8 float4 each), a triangle
+// list in submission order.
+void nv2a_gpu_draw(const float *verts, int n, const Nv2aGpuState *s);
+// The same, as a triangle list of indices into verts[0..n).
+void nv2a_gpu_draw_indexed(const float *verts, int n, const uint32_t *idx, int nidx,
+                           const Nv2aGpuState *s);
+// flags: NV097_CLEAR_SURFACE bits (0x01 Z, 0x02 stencil, 0xF0 colour).
+void nv2a_gpu_clear(uint32_t flags, uint32_t argb, float depth01, const Nv2aGpuState *s);
+void nv2a_gpu_present(void);
+// Create or refill a texture from ARGB words (0xAARRGGBB), w*h per face, six
+// faces for a cube. Returns the handle to pass in Nv2aGpuStage.tex.
+void *nv2a_gpu_texture(void *handle, uint32_t w, uint32_t h, int cube, const uint32_t *argb);
+
+#endif
