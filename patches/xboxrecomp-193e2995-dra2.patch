+"cbuffer C : register(b0) {\n"
+"  float4 vp; uint4 at; uint4 rcm; uint4 misc; float4 fogp; float4 fogc;\n"
+"  float4 fc0; float4 fc1; uint4 cw[8]; float4 k0[8]; float4 k1[8]; float4 tsc[4];\n"
