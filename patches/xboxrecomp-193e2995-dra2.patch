diff --git a/src/input/test_input_slots.c b/src/input/test_input_slots.c
new file mode 100644
index 0000000..81d9e4f
--- /dev/null
+++ b/src/input/test_input_slots.c
@@ -0,0 +1,167 @@
+// Player slots, lights, button mapping and rumble, on SDL virtual gamepads.
+//
+//   cl /nologo /I.. /I<SDL3>\include test_input_slots.c <SDL3>\lib\x64\SDL3.lib
+//   (run with SDL3.dll beside it; exit code 0 = pass)
+#include "xinput_device.c"
+
+int xbox_FramebufferKeyDown(int vk) { (void)vk; return 0; }   // keyboard off
+
+static int s_led[8][3], s_led_set[8];
+
+static bool SDLCALL set_led(void *userdata, Uint8 r, Uint8 g, Uint8 b)
+{
+    int i = (int)(intptr_t)userdata;
+    s_led[i][0] = r; s_led[i][1] = g; s_led[i][2] = b; s_led_set[i]++;
+    return true;
+}
+
+static int s_rumble[8][2];
+
+static bool SDLCALL rumble(void *userdata, Uint16 low, Uint16 high)
+{
+    int i = (int)(intptr_t)userdata;
+    s_rumble[i][0] = low; s_rumble[i][1] = high;
+    return true;
+}
+
+static SDL_JoystickID attach_as(int i, Uint16 vendor, Uint16 product)
+{
+    SDL_VirtualJoystickDesc d;
+    SDL_INIT_INTERFACE(&d);
+    d.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+    d.vendor_id = vendor;
+    d.product_id = product;
+    d.naxes = SDL_GAMEPAD_AXIS_COUNT;
+    d.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+    d.name = "virtual pad";
+    d.userdata = (void *)(intptr_t)i;
+    d.SetLED = set_led;
+    d.Rumble = rumble;
+    return SDL_AttachVirtualJoystick(&d);
+}
+
+static SDL_JoystickID attach(int i) { return attach_as(i, 0, 0); }
+
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { fails++; printf("FAIL: " __VA_ARGS__); printf("\n"); } } while (0)
+
+static void poll_all(void)
+{
+    XBOX_INPUT_STATE st;
+    DWORD p;
+    for (p = 0; p < XBOX_MAX_CONTROLLERS; p++)
+        xbox_InputGetState(p, &st);
+}
+
+int main(void)
+{
+    SDL_JoystickID id[5];
+    SDL_Joystick *j3;
+    XBOX_INPUT_STATE st;
+    int i;
+
+    SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+    // Virtual pads only: a real controller would take player 1.
+    SDL_SetHint(SDL_HINT_JOYSTICK_HIDAPI, "0");
+    SDL_SetHint(SDL_HINT_JOYSTICK_RAWINPUT, "0");
+    SDL_SetHint(SDL_HINT_JOYSTICK_WGI, "0");
+    SDL_SetHint(SDL_HINT_JOYSTICK_GAMEINPUT, "0");
+    SDL_SetHint(SDL_HINT_JOYSTICK_DIRECTINPUT, "0");
+    SDL_SetHint(SDL_HINT_XINPUT_ENABLED, "0");
+    if (!SDL_Init(SDL_INIT_GAMEPAD)) { printf("SDL_Init: %s\n", SDL_GetError()); return 2; }
+    for (i = 0; i < 4; i++)
+        id[i] = attach(i);
+
+    poll_all();                                   // first poll scans at once
+    for (i = 0; i < 4; i++)
+        printf("slot %d: %s\n", i + 1, g_pads[i] ? SDL_GetGamepadName(g_pads[i]) : "(empty)");
+    for (i = 0; i < 4; i++)
+        CHECK(xbox_InputIsConnected((DWORD)i) && SDL_GetGamepadID(g_pads[i]) == id[i],
+              "pad %d is not player %d", i + 1, i + 1);
+
+    j3 = SDL_GetJoystickFromID(id[2]);
+    SDL_SetJoystickVirtualButton(j3, SDL_GAMEPAD_BUTTON_START, true);
+    SDL_UpdateGamepads();
+    xbox_InputGetState(2, &st);
+    CHECK(st.Gamepad.wButtons & XBOX_GAMEPAD_START, "START not seen on player 3");
+    CHECK(s_led_set[2] && s_led[2][0] == 24 && s_led[2][1] == 200 && s_led[2][2] == 64,
+          "player 3 LED is %d,%d,%d (want green 24,200,64)", s_led[2][0], s_led[2][1], s_led[2][2]);
+    CHECK(!s_led_set[0] && !s_led_set[1] && !s_led_set[3], "a pad that did not press START was lit");
+
+    SDL_DetachVirtualJoystick(id[1]);
+    SDL_Delay(600);                               // the slot scan runs twice a second
+    poll_all();
+    CHECK(!xbox_InputIsConnected(1), "slot 2 still connected after unplug");
+    CHECK(xbox_InputIsConnected(0) && xbox_InputIsConnected(2) && xbox_InputIsConnected(3),
+          "an unplug moved other players");
+    id[4] = attach(4);
+    SDL_Delay(600);
+    poll_all();
+    CHECK(xbox_InputIsConnected(1) && SDL_GetGamepadID(g_pads[1]) == id[4],
+          "the new pad did not take the free slot 2");
+
+    // A Switch Pro (057E:2009) maps by letter: its bottom button is B.
+    CHECK(face_button(g_pads[0], 0) == SDL_GAMEPAD_BUTTON_SOUTH, "generic pad: A is not the bottom button");
+    SDL_DetachVirtualJoystick(id[3]);
+    SDL_Delay(600);
+    poll_all();
+    {
+        SDL_JoystickID nid = attach_as(5, 0x057E, 0x2009);
+        SDL_Joystick *nj;
+        SDL_Delay(600);
+        poll_all();
+        CHECK(xbox_InputIsConnected(3) && SDL_GetGamepadID(g_pads[3]) == nid, "the Nintendo pad is not player 4");
+        printf("player 4: %s (type %d)\n", g_pads[3] ? SDL_GetGamepadName(g_pads[3]) : "(empty)",
+               g_pads[3] ? (int)SDL_GetGamepadType(g_pads[3]) : -1);
+        CHECK(g_pads[3] && face_button(g_pads[3], 0) == SDL_GAMEPAD_BUTTON_EAST
+                        && face_button(g_pads[3], 1) == SDL_GAMEPAD_BUTTON_SOUTH,
+              "Nintendo pad: A/B not mapped by letter");
+        nj = SDL_GetJoystickFromID(nid);
+        SDL_SetJoystickVirtualButton(nj, SDL_GAMEPAD_BUTTON_SOUTH, true);
+        SDL_UpdateGamepads();
+        xbox_InputGetState(3, &st);
+        CHECK(st.Gamepad.bAnalogButtons[XBOX_BUTTON_B] == 255 && st.Gamepad.bAnalogButtons[XBOX_BUTTON_A] == 0,
+              "Nintendo pad: bottom (B) press reached the game as A=%d B=%d",
+              st.Gamepad.bAnalogButtons[XBOX_BUTTON_A], st.Gamepad.bAnalogButtons[XBOX_BUTTON_B]);
+        SDL_SetJoystickVirtualButton(nj, SDL_GAMEPAD_BUTTON_SOUTH, false);
+        SDL_SetJoystickVirtualButton(nj, SDL_GAMEPAD_BUTTON_EAST, true);
+        SDL_UpdateGamepads();
+        xbox_InputGetState(3, &st);
+        CHECK(st.Gamepad.bAnalogButtons[XBOX_BUTTON_A] == 255 && st.Gamepad.bAnalogButtons[XBOX_BUTTON_B] == 0,
+              "Nintendo pad: right (A) press reached the game as A=%d B=%d",
+              st.Gamepad.bAnalogButtons[XBOX_BUTTON_A], st.Gamepad.bAnalogButtons[XBOX_BUTTON_B]);
+    }
+
+    {
+        XBOX_VIBRATION v = { 0x1234, 0xFEDC };
+        CHECK(xbox_InputSetState(2, &v) == ERROR_SUCCESS, "rumble on player 3 refused");
+        CHECK(s_rumble[2][0] == 0x1234 && s_rumble[2][1] == 0xFEDC,
+              "player 3 rumble is %04X/%04X (want 1234/FEDC)", s_rumble[2][0], s_rumble[2][1]);
+        CHECK(s_rumble[0][0] == 0 && s_rumble[0][1] == 0, "rumble reached player 1");
+        v.wLeftMotorSpeed = v.wRightMotorSpeed = 0;
+        xbox_InputSetState(2, &v);
+        CHECK(s_rumble[2][0] == 0 && s_rumble[2][1] == 0, "player 3 rumble did not stop");
+    }
+
+    {
+        SDL_JoystickID nid;
+        SDL_SetGamepadPlayerIndex(g_pads[0], 3);            // as SDL would
+        SDL_DetachVirtualJoystick(id[2]);                   // joined player 3
+        SDL_Delay(600);
+        poll_all();
+        nid = attach(7);
+        SDL_Delay(600);
+        poll_all();
+        CHECK(xbox_InputIsConnected(2) && SDL_GetGamepadID(g_pads[2]) == nid,
+              "the reconnected pad is not player 3");
+        CHECK(s_led_set[7] && s_led[7][0] == 24 && s_led[7][1] == 200 && s_led[7][2] == 64,
+              "reconnected player 3 LED is %d,%d,%d (want green)", s_led[7][0], s_led[7][1], s_led[7][2]);
+        for (i = 0; i < 4; i++)
+            CHECK(g_pads[i] && SDL_GetGamepadPlayerIndex(g_pads[i]) == i, "player %d has SDL number %d",
+                  i + 1, g_pads[i] ? SDL_GetGamepadPlayerIndex(g_pads[i]) : -9);
+    }
+
+    printf(fails ? "%d check(s) failed\n" : "all checks passed\n", fails);
+    SDL_Quit();
+    return fails ? 1 : 0;
+}
