+/* Kelvin semaphore release: XDK D3D fences poll this word. The context handle
+ * resolves through RAMHT, which the title writes into PRAMIN itself. */
+#define NV097_SET_CONTEXT_DMA_SEMAPHORE        0x01A4   /* values as in nv2a_regs.h */
+#define NV097_SET_SEMAPHORE_OFFSET             0x1D6C
+#define NV097_BACK_END_WRITE_SEMAPHORE_RELEASE 0x1D70
+#define NV2A_MMIO_VA   0xFD000000u
+#define NV2A_PRAMIN_VA (NV2A_MMIO_VA + 0x700000u)
+static uint32_t s_sem_instance, s_sem_offset;
+static void note_unhandled(uint32_t method, uint32_t param);
+
+/* Cached: getenv per draw showed in profiles. */
