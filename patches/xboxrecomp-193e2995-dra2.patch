+"float4 stage(uint st, float4 c, inout bool keep) {\n"
+"  uint mode = (rcm.y >> (st * 5)) & 0x1F; float q = c.w != 0 ? c.w : 1;\n"
+"  if (mode == 0) return float4(0, 0, 0, 1);\n"
+"  if (mode == 4) return saturate(c);\n"
+"  if (mode == 5) { [unroll] for (int j = 0; j < 4; j++) { bool ge = (misc.z >> (st * 4 + j)) & 1;\n"
+"      if (ge ? c[j] >= 0 : c[j] < 0) keep = false; } return 0; }\n"
+"  if (mode == 3 && tsc[st].z) {\n"
+"    if (st == 0) return tcx[0].SampleLevel(sm[0], c.xyz, 0); if (st == 1) return tcx[1].SampleLevel(sm[1], c.xyz, 0);\n"
+"    if (st == 2) return tcx[2].SampleLevel(sm[2], c.xyz, 0); return tcx[3].SampleLevel(sm[3], c.xyz, 0); }\n"
+"  float2 uv = (mode == 3 ? c.xy : c.xy / q) * tsc[st].xy;\n"
+"  if (mode > 3) return 0;\n"
+"  if (st == 0) return tx[0].SampleLevel(sm[0], uv, 0); if (st == 1) return tx[1].SampleLevel(sm[1], uv, 0);\n"
+"  if (st == 2) return tx[2].SampleLevel(sm[2], uv, 0); return tx[3].SampleLevel(sm[3], uv, 0);\n"
+"}\n"
+"float4 ps(VO i) : SV_Target {\n"
+"  float4 c;\n"
+"  if (at.w) return float4(1, 0, 1, 1);\n"
+"  if (misc.x) {\n"
+"    float4 t[4]; bool keep = true;\n"
+"    [unroll] for (uint st = 0; st < 4; st++) t[st] = stage(st, i.t[st], keep);\n"
+"    if (!keep) discard;\n"
+"    c = combine(i.d0, i.d1, i.f, t);\n"
+"  } else {\n"
+"    c = i.d0;\n"
+"    if (misc.y) c *= tx[0].SampleLevel(sm[0], i.t[0].xy * tsc[0].xy, 0);\n"
+"  }\n"
+"  if (at.x && !alpha_pass(c.a)) discard;\n"
+"  return c;\n"
+"}\n";
+
+typedef struct {
+    float vp[4]; uint32_t at[4]; uint32_t rcm[4]; uint32_t misc[4];
+    float fogp[4]; float fogc[4]; float fc0[4]; float fc1[4];
+    uint32_t cw[8][4]; float k0[8][4]; float k1[8][4]; float tsc[4][4];
+} Consts;
+
+static void fail(const char *what, HRESULT hr)
+{
+    fprintf(stderr, "[GPU-D3D11] %s failed (0x%08lX); software rasteriser stays on\n",
+            what, (unsigned long)hr);
+    fflush(stderr);
+    s_state = 0;
+}
+
+static ID3DBlob *compile_src(const char *src, size_t len, const char *entry, const char *target)
+{
+    ID3DBlob *code = NULL, *err = NULL;
+    HRESULT hr = D3DCompile(src, len, "nv2a_gpu", NULL, NULL,
+                            entry, target, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[GPU-D3D11] %s: %s\n", entry,
+                err ? (const char *)ID3D10Blob_GetBufferPointer(err) : "?");
+        if (err) ID3D10Blob_Release(err);
+        return NULL;
+    }
+    if (err) ID3D10Blob_Release(err);
+    return code;
+}
+
+void *nv2a_gpu_texture(void *handle, uint32_t w, uint32_t h, int cube, const uint32_t *argb)
+{
+    GpuTex *t = (GpuTex *)handle;
+    uint32_t faces = cube ? 6 : 1, f;
+
+    if (!s_dev || !w || !h)
+        return handle;
+    if (t && (t->w != w || t->h != h || t->cube != cube)) {
+        ID3D11ShaderResourceView_Release(t->srv);
+        ID3D11Texture2D_Release(t->tex);
+        free(t);
+        t = NULL;
+    }
+    if (!t) {
+        D3D11_TEXTURE2D_DESC td;
+        D3D11_SHADER_RESOURCE_VIEW_DESC sv;
+        t = (GpuTex *)calloc(1, sizeof *t);
+        if (!t)
+            return NULL;
+        memset(&td, 0, sizeof td);
+        td.Width = w; td.Height = h; td.MipLevels = 1; td.ArraySize = faces;
+        td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;   // ARGB words, little-endian
+        td.SampleDesc.Count = 1;
+        td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        td.MiscFlags = cube ? D3D11_RESOURCE_MISC_TEXTURECUBE : 0;
+        memset(&sv, 0, sizeof sv);
+        sv.Format = td.Format;
+        sv.ViewDimension = cube ? D3D11_SRV_DIMENSION_TEXTURECUBE : D3D11_SRV_DIMENSION_TEXTURE2D;
+        if (cube) sv.TextureCube.MipLevels = 1; else sv.Texture2D.MipLevels = 1;
+        if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &t->tex))
+            || FAILED(ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)t->tex, &sv, &t->srv))) {
+            if (t->tex) ID3D11Texture2D_Release(t->tex);
+            free(t);
+            return NULL;
+        }
+        t->w = w; t->h = h; t->cube = cube;
+    }
+    for (f = 0; f < faces; f++)
+        ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)t->tex, f, NULL,
+                                              argb + (size_t)f * w * h, w * 4, 0);
+    return t;
+}
+
+static ID3D11ShaderResourceView *white(int cube)
+{
+    static const uint32_t px[6] = { 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu,
+                                    0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu };
+    GpuTex *t = (GpuTex *)nv2a_gpu_texture(NULL, 1, 1, cube, px);
+    return t ? t->srv : NULL;
+}
+
+static int init(void)
+{
+    DXGI_SWAP_CHAIN_DESC sd;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_BUFFER_DESC bd;
+    ID3D11Texture2D *bb = NULL, *zt = NULL;
+    ID3DBlob *vsb, *psb;
+    HWND hwnd;
+    HRESULT hr;
+    static const D3D11_INPUT_ELEMENT_DESC el[] = {
+        { "POSITION", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 0,   D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "COLOR",    0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 16,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "COLOR",    1, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 32,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 4, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 48,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 64,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 1, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 80,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 2, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 96,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 3, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 112, D3D11_INPUT_PER_VERTEX_DATA, 0 },
+    };
+
+    if (getenv("RECOMP_GPU_SCALE"))
+        s_scale = (float)atof(getenv("RECOMP_GPU_SCALE"));
+    if (s_scale < 1.0f) s_scale = 1.0f;
+    s_w = (UINT)(640 * s_scale + 0.5f);
+    s_h = (UINT)(480 * s_scale + 0.5f);
+    if (getenv("RECOMP_WIDESCREEN") && atoi(getenv("RECOMP_WIDESCREEN"))) {
+        s_w = (s_h * 16 / 9 + 1) & ~1u;
+        s_ws = (640 * s_scale) / (float)s_w;
+    }
+    hwnd = (HWND)xbox_FramebufferWindowHandle();   // nv2a_gpu_on waits for it
+
+    {   // The back buffer is the window; the game draws off screen at s_w x s_h.
+        RECT cr;
+        GetClientRect(hwnd, &cr);
+        s_bb_w = cr.right > 0 ? (UINT)cr.right : s_w;
+        s_bb_h = cr.bottom > 0 ? (UINT)cr.bottom : s_h;
+    }
+    memset(&sd, 0, sizeof sd);
+    sd.BufferDesc.Width = s_bb_w;
+    sd.BufferDesc.Height = s_bb_h;
+    sd.BufferDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    sd.SampleDesc.Count = 1;
+    sd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    sd.BufferCount = 2;
+    sd.OutputWindow = hwnd;
+    sd.Windowed = TRUE;
+    sd.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    hr = D3D11CreateDeviceAndSwapChain(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, 0, NULL, 0,
+                                       D3D11_SDK_VERSION, &sd, &s_swap, &s_dev, NULL, &s_ctx);
+    if (FAILED(hr)) { fail("D3D11CreateDeviceAndSwapChain", hr); return 0; }
+
+    {   // F11/Alt+Enter are the window's borderless toggle, not DXGI's mode switch.
+        IDXGIFactory *f = NULL;
+        if (SUCCEEDED(IDXGISwapChain_GetParent(s_swap, &IID_IDXGIFactory, (void **)&f))) {
+            IDXGIFactory_MakeWindowAssociation(f, hwnd, DXGI_MWA_NO_ALT_ENTER);
+            IDXGIFactory_Release(f);
+        }
+    }
+    hr = IDXGISwapChain_GetBuffer(s_swap, 0, &IID_ID3D11Texture2D, (void **)&bb);
+    if (FAILED(hr)) { fail("GetBuffer", hr); return 0; }
+    hr = ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)bb, NULL, &s_bb_rtv);
+    ID3D11Texture2D_Release(bb);
+    if (FAILED(hr)) { fail("CreateRenderTargetView", hr); return 0; }
+
+    memset(&td, 0, sizeof td);                     // the game's own target
+    td.Width = s_w; td.Height = s_h; td.MipLevels = 1; td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    hr = ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &bb);
+    if (FAILED(hr)) { fail("render target", hr); return 0; }
+    ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)bb, NULL, &s_rtv);
+    ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)bb, NULL, &s_rt_srv);
+    ID3D11Texture2D_Release(bb);
+    if (!s_rtv || !s_rt_srv) { fail("render target views", E_FAIL); return 0; }
+
+    memset(&td, 0, sizeof td);
+    td.Width = s_w; td.Height = s_h; td.MipLevels = 1; td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    td.SampleDesc.Count = 1;
+    td.BindFlags = D3D11_BIND_DEPTH_STENCIL;
+    hr = ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &zt);
+    if (FAILED(hr)) { fail("depth texture", hr); return 0; }
+    hr = ID3D11Device_CreateDepthStencilView(s_dev, (ID3D11Resource *)zt, NULL, &s_dsv);
+    ID3D11Texture2D_Release(zt);
+    if (FAILED(hr)) { fail("CreateDepthStencilView", hr); return 0; }
+
+    vsb = compile_src(s_hlsl, sizeof s_hlsl - 1, "vs", "vs_5_0");
+    psb = compile_src(s_hlsl, sizeof s_hlsl - 1, "ps", "ps_5_0");
+    if (!vsb || !psb) { fail("shader compile", E_FAIL); return 0; }
+    ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(vsb),
+                                    ID3D10Blob_GetBufferSize(vsb), NULL, &s_vs);
+    ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(psb),
+                                   ID3D10Blob_GetBufferSize(psb), NULL, &s_ps);
+    hr = ID3D11Device_CreateInputLayout(s_dev, el, 8, ID3D10Blob_GetBufferPointer(vsb),
+                                        ID3D10Blob_GetBufferSize(vsb), &s_layout);
+    ID3D10Blob_Release(vsb); ID3D10Blob_Release(psb);
+    if (FAILED(hr) || !s_vs || !s_ps) { fail("shader objects", hr); return 0; }
+
+    memset(&bd, 0, sizeof bd);
+    bd.ByteWidth = s_vb_bytes;
+    bd.Usage = D3D11_USAGE_DYNAMIC;
+    bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_vb);
+    if (FAILED(hr)) { fail("vertex buffer", hr); return 0; }
+    bd.ByteWidth = s_ib_bytes;
+    bd.BindFlags = D3D11_BIND_INDEX_BUFFER;
+    hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_ib);
+    if (FAILED(hr)) { fail("index buffer", hr); return 0; }
+    bd.ByteWidth = sizeof(Consts);
+    bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    bd.Usage = D3D11_USAGE_DEFAULT;        // filled by UpdateSubresource, which a
+    bd.CPUAccessFlags = 0;                 // DYNAMIC buffer silently refuses
+    hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_cb);
+    if (FAILED(hr)) { fail("constant buffer", hr); return 0; }
+    s_debug = getenv("RECOMP_GPU_DEBUG") != NULL;
+    {
+        ID3DBlob *bv = compile_src(s_blit_hlsl, sizeof s_blit_hlsl - 1, "vs", "vs_5_0");
+        ID3DBlob *bp = compile_src(s_blit_hlsl, sizeof s_blit_hlsl - 1, "ps", "ps_5_0");
+        ID3DBlob *ba = compile_src(s_blit_hlsl, sizeof s_blit_hlsl - 1, "psa", "ps_5_0");
+        D3D11_SAMPLER_DESC sm;
+        if (!bv || !bp || !ba) { fail("blit shader compile", E_FAIL); return 0; }
+        ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(ba),
+                                       ID3D10Blob_GetBufferSize(ba), NULL, &s_blit_psa);
+        ID3D10Blob_Release(ba);
+        ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(bv),
+                                        ID3D10Blob_GetBufferSize(bv), NULL, &s_blit_vs);
+        ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(bp),
+                                       ID3D10Blob_GetBufferSize(bp), NULL, &s_blit_ps);
+        ID3D10Blob_Release(bv); ID3D10Blob_Release(bp);
+        memset(&sm, 0, sizeof sm);
+        sm.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+        sm.AddressU = sm.AddressV = sm.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+        sm.MaxLOD = D3D11_FLOAT32_MAX;
+        ID3D11Device_CreateSamplerState(s_dev, &sm, &s_blit_smp);
+    }
+    s_white2d = white(0);
+    s_whitecube = white(1);
+
+    fprintf(stderr, "[GPU-D3D11] up: %ux%u internal (scale %.2f)\n", s_w, s_h, s_scale);
+    fflush(stderr);
+    return 1;
+}
+
+int nv2a_gpu_on(void)
+{
+    if (s_state < 0) {
+        if (!getenv("RECOMP_GPU") || *getenv("RECOMP_GPU") == '0')
+            s_state = 0;
+        else if (xbox_FramebufferWindowHandle())   // the window opens at the
+            s_state = init();                       // title's first mode set;
+    }                                               // until then the CPU draws
+    return s_state == 1;
+}
+
+// GL blend factor -> D3D11; alpha slots cannot take colour factors.
+static D3D11_BLEND blend_of(uint32_t f, int alpha)
+{
+    switch (f) {
+    case 0x0000: return D3D11_BLEND_ZERO;
+    case 0x0001: return D3D11_BLEND_ONE;
+    case 0x0300: return alpha ? D3D11_BLEND_SRC_ALPHA : D3D11_BLEND_SRC_COLOR;
+    case 0x0301: return alpha ? D3D11_BLEND_INV_SRC_ALPHA : D3D11_BLEND_INV_SRC_COLOR;
+    case 0x0302: return D3D11_BLEND_SRC_ALPHA;
+    case 0x0303: return D3D11_BLEND_INV_SRC_ALPHA;
+    case 0x0304: return D3D11_BLEND_DEST_ALPHA;
+    case 0x0305: return D3D11_BLEND_INV_DEST_ALPHA;
+    case 0x0306: return alpha ? D3D11_BLEND_DEST_ALPHA : D3D11_BLEND_DEST_COLOR;
+    case 0x0307: return alpha ? D3D11_BLEND_INV_DEST_ALPHA : D3D11_BLEND_INV_DEST_COLOR;
+    case 0x0308: return alpha ? D3D11_BLEND_ONE : D3D11_BLEND_SRC_ALPHA_SAT;
+    case 0x8001: case 0x8003: return D3D11_BLEND_BLEND_FACTOR;
+    case 0x8002: case 0x8004: return D3D11_BLEND_INV_BLEND_FACTOR;
+    default:     return f ? D3D11_BLEND_ONE : D3D11_BLEND_ZERO;
+    }
+}
+
+static D3D11_BLEND_OP blend_op_of(uint32_t eq)
+{
+    switch (eq) {
+    case 0x800A: return D3D11_BLEND_OP_SUBTRACT;
+    case 0x800B: return D3D11_BLEND_OP_REV_SUBTRACT;
+    case 0x8007: return D3D11_BLEND_OP_MIN;
+    case 0x8008: return D3D11_BLEND_OP_MAX;
+    default:     return D3D11_BLEND_OP_ADD;
+    }
+}
+
+static void set_target(const Nv2aGpuState *s)
+{
+    D3D11_VIEWPORT vp;
+    D3D11_RECT sc;
+
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &s_rtv, s_dsv);
+    vp.TopLeftX = 0; vp.TopLeftY = 0;
+    vp.Width = s_ws < 1.0f ? (float)s_w : s->width * s_scale; vp.Height = s->height * s_scale;
+    vp.MinDepth = 0; vp.MaxDepth = 1;
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    sc.left = (LONG)(s->clip_x * s_scale);
+    sc.top = (LONG)(s->clip_y * s_scale);
+    sc.right = (LONG)((s->clip_x + s->clip_w) * s_scale);
+    sc.bottom = (LONG)((s->clip_y + s->clip_h) * s_scale);
+    if (s_ws < 1.0f) {   // widescreen: a full-width scissor opens the sides, others shift
+        LONG bar = (LONG)(s_w - 640 * s_scale) / 2;
+        if (s->clip_x == 0 && s->clip_w >= s->width) { sc.left = 0; sc.right = (LONG)s_w; }
+        else { sc.left += bar; sc.right += bar; }
+    }
+    ID3D11DeviceContext_RSSetScissorRects(s_ctx, 1, &sc);
+    s_last_sc = sc;
+}
+
+static void unpack(uint32_t c, float o[4])
+{
+    o[0] = (float)((c >> 16) & 0xFF) / 255.0f;
+    o[1] = (float)((c >> 8) & 0xFF) / 255.0f;
+    o[2] = (float)(c & 0xFF) / 255.0f;
+    o[3] = (float)(c >> 24) / 255.0f;
+}
+
+// idx/nidx: a triangle list over verts[0..n), or NULL for verts already in
+// triangle-list order.
+// Dynamic buffers as rings, discarded only on wrap: a discard per draw made
+// the driver rename them every time.
+static UINT s_vb_pos, s_ib_pos;
+
+static UINT ring_put(ID3D11Buffer *b, UINT *pos, UINT size, const void *src, UINT bytes)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    D3D11_MAP mode = D3D11_MAP_WRITE_NO_OVERWRITE;
+    UINT at;
+    if (*pos + bytes > size) {
+        *pos = 0;
+        mode = D3D11_MAP_WRITE_DISCARD;
+    }
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)b, 0, mode, 0, &m)))
+        return ~0u;
+    at = *pos;
+    memcpy((uint8_t *)m.pData + at, src, bytes);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)b, 0);
+    *pos += bytes;
+    return at;
+}
+
+static void draw_common(const float *verts, int n, const uint32_t *idx, int nidx,
+                        const Nv2aGpuState *s)
+{
+    D3D11_RASTERIZER_DESC rd;
+    D3D11_DEPTH_STENCIL_DESC dd;
+    D3D11_BLEND_DESC bd;
+    D3D11_SAMPLER_DESC smd;
+    ID3D11RasterizerState *rs = NULL;
+    ID3D11DepthStencilState *ds = NULL;
+    ID3D11BlendState *bs = NULL;
+    ID3D11SamplerState *smp[4] = { 0 };
+    ID3D11ShaderResourceView *srv[8];
+    Consts k;
+    UINT stride = 128, offset = 0, per = s_vb_bytes / 128 / 3 * 3;
+    float bf[4];
+    int done, i;
+
+    if (!nv2a_gpu_on() || n <= 0)
+        return;
+    if (!s_frame_draws++)
+        memcpy(s_first_v, verts, sizeof s_first_v);
+    s_frame_verts += (uint32_t)n;
+    set_target(s);
+
+    memset(&rd, 0, sizeof rd);
+    rd.FillMode = D3D11_FILL_SOLID;
+    // NV2A names the front face in GL's y-up sense; D3D11 judges winding on
+    // the y-down target, so the sense flips.
+    rd.CullMode = !s->cull_enable ? D3D11_CULL_NONE
+                : s->cull_face == 0x404 ? D3D11_CULL_BACK
+                : s->cull_face == 0x405 ? D3D11_CULL_FRONT : D3D11_CULL_NONE;
+    rd.FrontCounterClockwise = s->front_face == 0x900;
+    rd.DepthClipEnable = FALSE;             // nor does it clip depth
+    rd.ScissorEnable = TRUE;
+    ID3D11Device_CreateRasterizerState(s_dev, &rd, &rs);
+
+    memset(&dd, 0, sizeof dd);
+    dd.DepthEnable = !s_debug && (s->depth_test || s->depth_mask);
+    dd.DepthWriteMask = s->depth_mask ? D3D11_DEPTH_WRITE_MASK_ALL : D3D11_DEPTH_WRITE_MASK_ZERO;
+    dd.DepthFunc = !s->depth_test ? D3D11_COMPARISON_ALWAYS
+                 : (s->depth_func >= 0x200 && s->depth_func <= 0x207)
+                   ? (D3D11_COMPARISON_FUNC)(s->depth_func - 0x200 + 1) : D3D11_COMPARISON_ALWAYS;
+    ID3D11Device_CreateDepthStencilState(s_dev, &dd, &ds);
+
+    memset(&bd, 0, sizeof bd);
+    bd.RenderTarget[0].BlendEnable = !s_debug && s->blend_enable
+        && !(s->blend_sfactor == 1 && s->blend_dfactor == 0);
+    bd.RenderTarget[0].SrcBlend = blend_of(s->blend_sfactor, 0);
+    bd.RenderTarget[0].DestBlend = blend_of(s->blend_dfactor, 0);
+    bd.RenderTarget[0].BlendOp = blend_op_of(s->blend_equation);
+    bd.RenderTarget[0].SrcBlendAlpha = blend_of(s->blend_sfactor, 1);
+    bd.RenderTarget[0].DestBlendAlpha = blend_of(s->blend_dfactor, 1);
+    bd.RenderTarget[0].BlendOpAlpha = blend_op_of(s->blend_equation);
+    bd.RenderTarget[0].RenderTargetWriteMask =
+          ((s->color_mask & 0x00010000u) ? D3D11_COLOR_WRITE_ENABLE_RED : 0)
+        | ((s->color_mask & 0x00000100u) ? D3D11_COLOR_WRITE_ENABLE_GREEN : 0)
+        | ((s->color_mask & 0x00000001u) ? D3D11_COLOR_WRITE_ENABLE_BLUE : 0)
+        | ((s->color_mask & 0x01000000u) ? D3D11_COLOR_WRITE_ENABLE_ALPHA : 0);
+    ID3D11Device_CreateBlendState(s_dev, &bd, &bs);
+    // Constant colour is ARGB; *_ALPHA factors want alpha in every channel.
+    // A draw mixing both gets the colour form.
+    if (s->blend_sfactor == 0x8003 || s->blend_sfactor == 0x8004
+        || s->blend_dfactor == 0x8003 || s->blend_dfactor == 0x8004)
+        bf[0] = bf[1] = bf[2] = bf[3] = (float)(s->blend_color >> 24) / 255.0f;
+    else
+        unpack(s->blend_color, bf);
+
+    memset(&k, 0, sizeof k);
+    k.vp[0] = s->width; k.vp[1] = s->height; k.vp[2] = 1.0f / s->zmax;
+    k.vp[3] = s_ws;
+    k.at[0] = s->alpha_test;
+    k.at[1] = (s->alpha_func >= 0x200 && s->alpha_func <= 0x207) ? s->alpha_func - 0x200 : 7;
+    k.at[2] = s->alpha_ref & 0xFF;
+    k.at[3] = s_debug;
+    k.rcm[0] = s->rc.control; k.rcm[1] = s->rc.stage_program;
+    k.rcm[2] = s->rc.final0;  k.rcm[3] = s->rc.final1;
+    k.misc[0] = (uint32_t)s->use_rc;
+    k.misc[1] = s->st[0].tex != NULL;
+    k.misc[2] = s->clip_plane_mode;
+    k.misc[3] = s->fog_enable;
+    k.fogp[0] = (float)s->fog_mode; k.fogp[1] = s->fog_param[0]; k.fogp[2] = s->fog_param[1];
+    k.fogc[0] = s->fog_rgb[0]; k.fogc[1] = s->fog_rgb[1]; k.fogc[2] = s->fog_rgb[2];
+    unpack(s->rc.final_c0, k.fc0);
+    unpack(s->rc.final_c1, k.fc1);
+    for (i = 0; i < 8; i++) {
+        k.cw[i][0] = s->rc.color_icw[i]; k.cw[i][1] = s->rc.alpha_icw[i];
+        k.cw[i][2] = s->rc.color_ocw[i]; k.cw[i][3] = s->rc.alpha_ocw[i];
+        unpack(s->rc.factor0[i], k.k0[i]);
+        unpack(s->rc.factor1[i], k.k1[i]);
+    }
+    for (i = 0; i < 4; i++) {
+        const Nv2aGpuStage *st = &s->st[i];
+        GpuTex *t = (GpuTex *)st->tex;
+        k.tsc[i][0] = st->uscale; k.tsc[i][1] = st->vscale;
+        k.tsc[i][2] = (t && t->cube) ? 1.0f : 0.0f;
+        srv[i] = (t && !t->cube) ? t->srv : s_white2d;
+        srv[4 + i] = (t && t->cube) ? t->srv : s_whitecube;
+        memset(&smd, 0, sizeof smd);
+        smd.Filter = st->linear ? D3D11_FILTER_MIN_MAG_MIP_LINEAR : D3D11_FILTER_MIN_MAG_MIP_POINT;
+        smd.AddressU = st->wrap_u == 1 ? D3D11_TEXTURE_ADDRESS_WRAP : D3D11_TEXTURE_ADDRESS_CLAMP;
+        smd.AddressV = st->wrap_v == 1 ? D3D11_TEXTURE_ADDRESS_WRAP : D3D11_TEXTURE_ADDRESS_CLAMP;
+        smd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+        smd.MaxLOD = D3D11_FLOAT32_MAX;
+        ID3D11Device_CreateSamplerState(s_dev, &smd, &smp[i]);
+    }
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)s_cb, 0, NULL, &k, 0, 0);
+
+    ID3D11DeviceContext_IASetInputLayout(s_ctx, s_layout);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext_IASetVertexBuffers(s_ctx, 0, 1, &s_vb, &stride, &offset);
+    ID3D11DeviceContext_VSSetShader(s_ctx, s_vs, NULL, 0);
+    ID3D11DeviceContext_VSSetConstantBuffers(s_ctx, 0, 1, &s_cb);
+    ID3D11DeviceContext_PSSetShader(s_ctx, s_ps, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx, 0, 1, &s_cb);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 8, srv);
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 4, smp);
+    ID3D11DeviceContext_RSSetState(s_ctx, rs);
+    ID3D11DeviceContext_OMSetDepthStencilState(s_ctx, ds, 0);
+    ID3D11DeviceContext_OMSetBlendState(s_ctx, bs, bf, 0xFFFFFFFFu);
+
+    if (idx && (size_t)n * 128 <= s_vb_bytes && (size_t)nidx * 4 <= s_ib_bytes) {
+        UINT vb = ring_put(s_vb, &s_vb_pos, s_vb_bytes, verts, (UINT)n * 128);
+        UINT ib = vb == ~0u ? ~0u : ring_put(s_ib, &s_ib_pos, s_ib_bytes, idx, (UINT)nidx * 4);
+        if (ib != ~0u) {
+            ID3D11DeviceContext_IASetIndexBuffer(s_ctx, s_ib, DXGI_FORMAT_R32_UINT, 0);
+            ID3D11DeviceContext_DrawIndexed(s_ctx, (UINT)nidx, ib / 4, (INT)(vb / 128));
+        }
+    } else for (done = 0; done < n; done += (int)per) {
+        UINT cnt = (UINT)(n - done) < per ? (UINT)(n - done) : per;
+        UINT vb = ring_put(s_vb, &s_vb_pos, s_vb_bytes, verts + (size_t)done * 32, cnt * 128);
+        if (vb == ~0u)
+            break;
+        ID3D11DeviceContext_Draw(s_ctx, cnt, vb / 128);
+    }
+    if (rs) ID3D11RasterizerState_Release(rs);
+    if (ds) ID3D11DepthStencilState_Release(ds);
+    if (bs) ID3D11BlendState_Release(bs);
+    for (i = 0; i < 4; i++)
+        if (smp[i]) ID3D11SamplerState_Release(smp[i]);
+}
+
+void nv2a_gpu_draw(const float *verts, int n, const Nv2aGpuState *s)
+{
+    draw_common(verts, n, NULL, 0, s);
+}
+
+void nv2a_gpu_draw_indexed(const float *verts, int n, const uint32_t *idx, int nidx,
+                           const Nv2aGpuState *s)
+{
+    draw_common(verts, n, idx, nidx, s);
+}
+
+void nv2a_gpu_clear(uint32_t flags, uint32_t argb, float depth01, const Nv2aGpuState *s)
+{
+    if (!nv2a_gpu_on())
+        return;
+    // Whole-target clears: the title always clears its full 640x480 clip.
+    (void)s;
+    if (flags & 0xF0) {
+        float c[4];
+        unpack(argb, c);
+        ID3D11DeviceContext_ClearRenderTargetView(s_ctx, s_rtv, c);
+    }
+    if (flags & 0x03)
+        ID3D11DeviceContext_ClearDepthStencilView(s_ctx, s_dsv,
+            ((flags & 0x01) ? D3D11_CLEAR_DEPTH : 0) | ((flags & 0x02) ? D3D11_CLEAR_STENCIL : 0),
+            depth01 < 0 ? 0 : (depth01 > 1 ? 1 : depth01), 0);
+}
+
+// RECOMP_FB_DUMP=<prefix>: the presented frame every 10 s as a .bmp (guest
+// memory no longer holds it in GPU mode).
+static void dump_frame(void)
+{
+    static DWORD last;
+    static int seq;
+    const char *prefix = getenv("RECOMP_FB_DUMP");
+    ID3D11Resource *bb = NULL;
+    ID3D11Texture2D *st = NULL;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_MAPPED_SUBRESOURCE m;
+    char path[260];
+    FILE *f;
+    UINT x, y;
+
+    if (!prefix || GetTickCount() - last < 10000) {
+        s_frame_draws = s_frame_verts = 0;
+        return;
+    }
+    last = GetTickCount();
+    fprintf(stderr, "[GPU-D3D11] dump %d: %u draws, %u verts; first v (%g, %g, %g, %g);"
+            " scissor %ld,%ld-%ld,%ld\n", seq, s_frame_draws, s_frame_verts,
+            s_first_v[0], s_first_v[1], s_first_v[2], s_first_v[3],
+            s_last_sc.left, s_last_sc.top, s_last_sc.right, s_last_sc.bottom);
+    s_frame_draws = s_frame_verts = 0;
+    ID3D11RenderTargetView_GetResource(s_rtv, &bb);
+    memset(&td, 0, sizeof td);
+    td.Width = s_w; td.Height = s_h; td.MipLevels = 1; td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_STAGING; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (bb && SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &st))) {
+        ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)st, bb);
+        if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)st, 0, D3D11_MAP_READ, 0, &m))) {
+            snprintf(path, sizeof path, "%sgpu%05d.bmp", prefix, seq++);
+            if ((f = fopen(path, "wb")) != NULL) {
+                uint32_t row = s_w * 3, pad = (4 - row % 4) % 4, img = (row + pad) * s_h;
+                uint8_t h[54] = { 'B', 'M' };
+                *(uint32_t *)(h + 2) = 54 + img; *(uint32_t *)(h + 10) = 54;
+                *(uint32_t *)(h + 14) = 40; *(int32_t *)(h + 18) = (int32_t)s_w;
+                *(int32_t *)(h + 22) = (int32_t)s_h; *(uint16_t *)(h + 26) = 1;
+                *(uint16_t *)(h + 28) = 24; *(uint32_t *)(h + 34) = img;
+                fwrite(h, 1, 54, f);
+                for (y = s_h; y-- > 0;) {                 // bottom-up, BGR
+                    const uint8_t *p = (const uint8_t *)m.pData + (size_t)y * m.RowPitch;
+                    for (x = 0; x < s_w; x++) {
+                        uint8_t bgr[3] = { p[x * 4 + 2], p[x * 4 + 1], p[x * 4] };
+                        fwrite(bgr, 1, 3, f);
+                    }
+                    fwrite("\0\0\0", 1, pad, f);
+                }
+                fclose(f);
+            }
+            ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)st, 0);
+        }
+        ID3D11Texture2D_Release(st);
+    }
+    if (bb) ID3D11Resource_Release(bb);
+}
+
+static void *s_menu_tex;
+static ID3D11BlendState *s_menu_blend;
+static void draw_menu(void)
+{
+    int w, h, changed;
+    const uint32_t *px = port_menu_image((int)s_bb_h, &w, &h, &changed);
+    D3D11_VIEWPORT vp;
+    ID3D11ShaderResourceView *none = NULL;
+    if (!px)
+        return;
+    if (changed || !s_menu_tex)
+        s_menu_tex = nv2a_gpu_texture(s_menu_tex, (uint32_t)w, (uint32_t)h, 0, px);
+    if (!s_menu_tex)
+        return;
+    if (!s_menu_blend) {
+        D3D11_BLEND_DESC bd;
+        memset(&bd, 0, sizeof bd);
+        bd.RenderTarget[0].BlendEnable = TRUE;
+        bd.RenderTarget[0].SrcBlend = D3D11_BLEND_SRC_ALPHA;
+        bd.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+        bd.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+        bd.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ONE;
+        bd.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ZERO;
+        bd.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+        bd.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+        ID3D11Device_CreateBlendState(s_dev, &bd, &s_menu_blend);
+    }
+    vp.TopLeftX = (float)((int)s_bb_w - w) * 0.5f; vp.TopLeftY = (float)((int)s_bb_h - h) * 0.5f;
+    vp.Width = (float)w; vp.Height = (float)h; vp.MinDepth = 0; vp.MaxDepth = 1;
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    ID3D11DeviceContext_OMSetBlendState(s_ctx, s_menu_blend, NULL, 0xFFFFFFFFu);
+    ID3D11DeviceContext_PSSetShader(s_ctx, s_blit_psa, NULL, 0);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &((GpuTex *)s_menu_tex)->srv);
+    ID3D11DeviceContext_Draw(s_ctx, 3, 0);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &none);
+    ID3D11DeviceContext_OMSetBlendState(s_ctx, NULL, NULL, 0xFFFFFFFFu);
+}
+
+static void present_frame(int vsync, int menu)
+{
+    {   // Follow the window's size, then letterbox the 4:3 image into it.
+        HWND hwnd = (HWND)xbox_FramebufferWindowHandle();
+        RECT cr;
+        D3D11_VIEWPORT vp;
+        float c0[4] = { 0, 0, 0, 1 }, sx, sy;
+        ID3D11ShaderResourceView *none = NULL;
+        if (hwnd && GetClientRect(hwnd, &cr) && cr.right > 0 && cr.bottom > 0
+            && ((UINT)cr.right != s_bb_w || (UINT)cr.bottom != s_bb_h)) {
+            ID3D11Texture2D *bb = NULL;
+            ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 0, NULL, NULL);
+            ID3D11RenderTargetView_Release(s_bb_rtv);
+            s_bb_rtv = NULL;
+            if (SUCCEEDED(IDXGISwapChain_ResizeBuffers(s_swap, 0, (UINT)cr.right, (UINT)cr.bottom,
+                                                       DXGI_FORMAT_UNKNOWN, 0))) {
+                s_bb_w = (UINT)cr.right; s_bb_h = (UINT)cr.bottom;
+            }
+            IDXGISwapChain_GetBuffer(s_swap, 0, &IID_ID3D11Texture2D, (void **)&bb);
+            if (bb) {
+                ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)bb, NULL, &s_bb_rtv);
+                ID3D11Texture2D_Release(bb);
+            }
+        }
+        if (s_bb_rtv) {
+            float aspect = (float)s_w / (float)s_h;   // 4:3, or 16:9 with RECOMP_WIDESCREEN
+            sx = (float)s_bb_w; sy = sx / aspect;
+            if (sy > (float)s_bb_h) { sy = (float)s_bb_h; sx = sy * aspect; }
+            vp.TopLeftX = ((float)s_bb_w - sx) * 0.5f; vp.TopLeftY = ((float)s_bb_h - sy) * 0.5f;
+            vp.Width = sx; vp.Height = sy; vp.MinDepth = 0; vp.MaxDepth = 1;
+            ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &s_bb_rtv, NULL);
+            ID3D11DeviceContext_ClearRenderTargetView(s_ctx, s_bb_rtv, c0);
+            ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+            ID3D11DeviceContext_RSSetState(s_ctx, NULL);
+            ID3D11DeviceContext_OMSetBlendState(s_ctx, NULL, NULL, 0xFFFFFFFFu);
+            ID3D11DeviceContext_OMSetDepthStencilState(s_ctx, NULL, 0);
+            ID3D11DeviceContext_IASetInputLayout(s_ctx, NULL);
+            ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+            ID3D11DeviceContext_VSSetShader(s_ctx, s_blit_vs, NULL, 0);
+            ID3D11DeviceContext_PSSetShader(s_ctx, s_blit_ps, NULL, 0);
+            ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &s_rt_srv);
+            ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 1, &s_blit_smp);
+            ID3D11DeviceContext_Draw(s_ctx, 3, 0);
+            ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &none);  // the RT is drawn to next
+            if (menu)
+                draw_menu();
+        }
+    }
+    IDXGISwapChain_Present(s_swap, (UINT)vsync, 0);
+}
+
+// While the port menu is open the game is held at its flip, muted.
+extern volatile int g_audio_muted;
+
+void nv2a_gpu_present(void)
+{
+    static int vsync = -1;
+    int was_muted;
+    if (!nv2a_gpu_on())
+        return;
+    dump_frame();
+    if (vsync < 0)                       // 60 Hz pacing; RECOMP_GPU_VSYNC=0 to measure
+        vsync = !(getenv("RECOMP_GPU_VSYNC") && *getenv("RECOMP_GPU_VSYNC") == '0');
+    if (!port_menu_update()) {
+        present_frame(vsync, 0);
+        return;
+    }
+    was_muted = g_audio_muted;
+    g_audio_muted = 1;
+    do
+        present_frame(1, 1);
+    while (port_menu_update());
+    g_audio_muted = was_muted;
+}
