+}
+
+static uint32_t mmio32(uint32_t va)
+{
+    return *(const uint32_t *)((const uint8_t *)xbox_GetMemoryOffset() + va);
+}
+
+/* Instance address for an object handle, as PFIFO resolves 0x180-0x1FF method
+ * parameters; 0 when the entry is absent or invalid. */
+static uint32_t ramht_instance(uint32_t handle)
+{
+    uint32_t cfg = mmio32(NV2A_MMIO_VA + 0x2210);                 /* NV_PFIFO_RAMHT */
+    uint32_t size = 1u << (((cfg >> 16) & 3u) + 12);
+    uint32_t base = ((cfg >> 4) & 0x1Fu) << 12;
+    uint32_t chid = mmio32(NV2A_MMIO_VA + 0x3204) & 0x1Fu;          /* CACHE1_PUSH1 */
+    uint32_t bits = 0, h = handle, hash = 0, entry, context;
+
+    while ((1u << bits) < size)
+        bits++;
+    bits--;                                                     /* ctz(size) - 1 */
+    while (h) {
+        hash ^= h & ((1u << bits) - 1u);
+        h >>= bits;
+    }
+    hash ^= chid << (bits - 4);
+    entry = NV2A_PRAMIN_VA + base + (hash & (size / 8 - 1u)) * 8;
+    context = mmio32(entry + 4);
+    if (mmio32(entry) != handle || !(context & 0x80000000u))
+        return 0;
+    return (context & 0xFFFFu) << 4;
+}
+
+static void semaphore_release(uint32_t value)
+{
+    uint32_t obj, flags, limit, base;
+
+    if (!s_sem_instance) {
+        note_unhandled(NV097_BACK_END_WRITE_SEMAPHORE_RELEASE, value);
+        return;
+    }
+    obj = NV2A_PRAMIN_VA + s_sem_instance;
+    flags = mmio32(obj);
+    limit = mmio32(obj + 4);
+    base = (mmio32(obj + 8) & 0xFFFFF000u) | (flags >> 20);    /* address | adjust */
+    if ((uint64_t)s_sem_offset + 4 > (uint64_t)limit + 1
+        || (uint64_t)base + s_sem_offset + 4 > XBOX_CONTIG_SIZE) {
+        note_unhandled(NV097_BACK_END_WRITE_SEMAPHORE_RELEASE, value);
+        return;
+    }
+    /* Physical memory is what the title polls, through the contiguous window. */
+    *(uint32_t *)((uint8_t *)xbox_GetMemoryOffset() + XBOX_CONTIG_BASE + base + s_sem_offset) = value;
+}
