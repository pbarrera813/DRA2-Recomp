diff --git a/src/video/port_menu.c b/src/video/port_menu.c
new file mode 100644
index 0000000..4f218a7
--- /dev/null
+++ b/src/video/port_menu.c
@@ -0,0 +1,288 @@
+// The port menu: Resume, Resolution, Widescreen, Fullscreen, Monitor, Quit.
+// Back+Start also opens it, because the Game Bar and Steam may take the system
+// button. Resolution and widescreen apply on restart. Presenter thread only.
+#include "port_menu.h"
+
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern void xbox_InputMenuPoll(int *buttons);
+extern void xbox_InputMenuSetOpen(int open);
+extern void *xbox_FramebufferWindowHandle(void);
+
+#define PM_MONITOR_MSG (WM_APP + 1)   // fb_present.c: move to display n
+enum { ROW_RESUME, ROW_RES, ROW_WIDE, ROW_FULL, ROW_MON, ROW_QUIT, ROWS };
+
+static int s_open, s_sel, s_confirm, s_yes, s_dirty = 1;
+static int s_prev, s_combo_done;
+static ULONGLONG s_combo_t0;
+static int s_res, s_wide, s_full, s_mon, s_res0 = -1, s_wide0;
+static char s_ini[MAX_PATH];
+
+static int ini_get(const char *key, int def)
+{
+    return s_ini[0] ? (int)GetPrivateProfileIntA("display", key, def, s_ini) : def;
+}
+
+static void ini_set(const char *key, int value)
+{
+    char v[16];
+    if (!s_ini[0])
+        return;
+    snprintf(v, sizeof v, "%d", value);
+    WritePrivateProfileStringA("display", key, v, s_ini);
+}
+
+// Windows display numbers (the n in \\.\DISPLAYn), in order.
+static int s_disp[16], s_ndisp;
+static BOOL CALLBACK list_display(HMONITOR m, HDC dc, LPRECT r, LPARAM p)
+{
+    MONITORINFOEXA mi;
+    const char *d;
+    (void)dc; (void)r; (void)p;
+    mi.cbSize = sizeof mi;
+    if (s_ndisp < 16 && GetMonitorInfoA(m, (MONITORINFO *)&mi)
+        && (d = strstr(mi.szDevice, "DISPLAY")) != NULL)
+        s_disp[s_ndisp++] = atoi(d + 7);
+    return TRUE;
+}
+
+static int window_display(void)
+{
+    MONITORINFOEXA mi;
+    const char *d;
+    HWND h = (HWND)xbox_FramebufferWindowHandle();
+    mi.cbSize = sizeof mi;
+    if (h && GetMonitorInfoA(MonitorFromWindow(h, MONITOR_DEFAULTTONEAREST), (MONITORINFO *)&mi)
+        && (d = strstr(mi.szDevice, "DISPLAY")) != NULL)
+        return atoi(d + 7);
+    return 0;
+}
+
+static void open_menu(void)
+{
+    HWND h = (HWND)xbox_FramebufferWindowHandle();
+    if (s_res0 < 0) {
+        const char *e = getenv("RECOMP_SETTINGS_INI");
+        snprintf(s_ini, sizeof s_ini, "%s", e ? e : "");
+        s_res0 = ini_get("resolution", 1080);
+        s_wide0 = ini_get("widescreen", 1);
+    }
+    s_res = ini_get("resolution", 1080);
+    s_wide = ini_get("widescreen", 1);
+    s_full = h && (GetWindowLongA(h, GWL_STYLE) & WS_POPUP) ? 1 : 0;
+    s_ndisp = 0;
+    EnumDisplayMonitors(NULL, NULL, list_display, 0);
+    s_mon = window_display();
+    s_open = 1;
+    s_sel = ROW_RESUME;
+    s_confirm = 0;
+    s_dirty = 1;
+    xbox_InputMenuSetOpen(1);
+}
+
+static void close_menu(void)
+{
+    s_open = 0;
+    xbox_InputMenuSetOpen(0);   // the game ignores each pad until it is released
+}
+
+static void choose(void)
+{
+    HWND h = (HWND)xbox_FramebufferWindowHandle();
+    int i;
+    switch (s_sel) {
+    case ROW_RESUME:
+        close_menu();
+        break;
+    case ROW_RES:
+        s_res = s_res == 1080 ? 1440 : s_res == 1440 ? 2160 : 1080;
+        ini_set("resolution", s_res);
+        break;
+    case ROW_WIDE:
+        s_wide = !s_wide;
+        ini_set("widescreen", s_wide);
+        break;
+    case ROW_FULL:
+        s_full = !s_full;
+        ini_set("fullscreen", s_full);
+        if (h)
+            PostMessageA(h, WM_KEYDOWN, VK_F11, 0);   // the window's own toggle
+        break;
+    case ROW_MON:
+        for (i = 0; i < s_ndisp && s_disp[i] != s_mon; i++)
+            ;
+        if (s_ndisp)
+            s_mon = s_disp[(i + 1) % s_ndisp];
+        ini_set("monitor", s_mon);
+        if (h)
+            PostMessageA(h, PM_MONITOR_MSG, (WPARAM)s_mon, 0);
+        break;
+    case ROW_QUIT:
+        s_confirm = 1;
+        s_yes = 0;   // "No" first: a stray press never quits
+        break;
+    }
+    s_dirty = 1;
+}
+
+int port_menu_update(void)
+{
+    int b, edge;
+    ULONGLONG now = GetTickCount64();
+
+    xbox_InputMenuPoll(&b);
+    edge = b & ~s_prev;
+    s_prev = b;
+
+    if ((b & (PM_BACK | PM_START)) == (PM_BACK | PM_START)) {
+        if (!s_combo_t0)
+            s_combo_t0 = now;
+        if (!s_combo_done && now - s_combo_t0 >= 1000) {
+            s_combo_done = 1;
+            edge |= PM_GUIDE;
+        }
+    } else {
+        s_combo_t0 = 0;
+        s_combo_done = 0;
+    }
+
+    if (!s_open) {
+        if (edge & PM_GUIDE)
+            open_menu();
+        return s_open;
+    }
+    if (edge & PM_GUIDE) {
+        close_menu();
+        return 0;
+    }
+    if (s_confirm) {
+        if (edge & (PM_LEFT | PM_RIGHT | PM_UP | PM_DOWN)) { s_yes = !s_yes; s_dirty = 1; }
+        if (edge & PM_B) { s_confirm = 0; s_dirty = 1; }
+        if (edge & PM_A) {
+            if (s_yes) {
+                HWND h = (HWND)xbox_FramebufferWindowHandle();
+                if (h)
+                    PostMessageA(h, WM_CLOSE, 0, 0);   // the same exit as Alt+F4
+            }
+            s_confirm = 0;
+            s_dirty = 1;
+        }
+        return s_open;
+    }
+    if (edge & PM_UP)   { s_sel = (s_sel + ROWS - 1) % ROWS; s_dirty = 1; }
+    if (edge & PM_DOWN) { s_sel = (s_sel + 1) % ROWS; s_dirty = 1; }
+    if (edge & PM_A)
+        choose();
+    else if (edge & PM_B)
+        close_menu();
+    return s_open;
+}
+
+
+static uint32_t *s_px;
+static int s_w, s_h;
+
+static void text(HDC dc, const char *t, int x, int y, int w, int h, UINT align, COLORREF c)
+{
+    RECT r = { x, y, x + w, y + h };
+    SetTextColor(dc, c);
+    DrawTextA(dc, t, -1, &r, align | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+}
+
+const uint32_t *port_menu_image(int screen_h, int *w, int *h, int *changed)
+{
+    static const char *const names[ROWS] = {
+        "Resume", "Resolution", "Widescreen", "Fullscreen", "Monitor", "Quit game" };
+    int H = screen_h * 55 / 100, W = H * 6 / 5, row = H / 10, i;
+    BITMAPINFO bi;
+    HDC dc;
+    HBITMAP bm, old;
+    HFONT font, big, oldf;
+    uint32_t *bits = NULL;
+
+    *changed = 0;
+    if (!s_dirty && s_px && s_h == H) {
+        *w = s_w; *h = s_h;
+        return s_px;
+    }
+    memset(&bi, 0, sizeof bi);
+    bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+    bi.bmiHeader.biWidth = W;
+    bi.bmiHeader.biHeight = -H;   // top-down
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    dc = CreateCompatibleDC(NULL);
+    bm = CreateDIBSection(dc, &bi, DIB_RGB_COLORS, (void **)&bits, NULL, 0);
+    if (!dc || !bm || !bits) {
+        if (bm) DeleteObject(bm);
+        if (dc) DeleteDC(dc);
+        *w = s_w; *h = s_h;
+        return s_px;
+    }
+    old = (HBITMAP)SelectObject(dc, bm);
+    memset(bits, 0, (size_t)W * H * 4);
+    SetBkMode(dc, TRANSPARENT);
+    font = CreateFontA(-row * 55 / 100, 0, 0, 0, FW_SEMIBOLD, 0, 0, 0, DEFAULT_CHARSET, 0, 0,
+                       ANTIALIASED_QUALITY, 0, "Segoe UI");
+    big = CreateFontA(-row * 70 / 100, 0, 0, 0, FW_BOLD, 0, 0, 0, DEFAULT_CHARSET, 0, 0,
+                      ANTIALIASED_QUALITY, 0, "Segoe UI");
+    oldf = (HFONT)SelectObject(dc, big);
+    text(dc, "Digimon Rumble Arena 2", 0, row / 3, W, row, DT_CENTER, RGB(255, 255, 255));
+    SelectObject(dc, font);
+    for (i = 0; i < ROWS; i++) {
+        char v[48] = "";
+        int y = row * 3 / 2 + i * row + row / 4;
+        COLORREF c = (i == s_sel && !s_confirm) ? RGB(255, 210, 40) : RGB(235, 235, 235);
+        if (i == ROW_RES)
+            snprintf(v, sizeof v, "%dp%s", s_res, s_res != s_res0 ? "  (restart)" : "");
+        else if (i == ROW_WIDE)
+            snprintf(v, sizeof v, "%s%s", s_wide ? "16:9" : "4:3", s_wide != s_wide0 ? "  (restart)" : "");
+        else if (i == ROW_FULL)
+            snprintf(v, sizeof v, "%s", s_full ? "On" : "Off");
+        else if (i == ROW_MON)
+            snprintf(v, sizeof v, "Display %d", s_mon);
+        text(dc, names[i], W / 10, y, W, row, DT_LEFT, c);
+        if (v[0])
+            text(dc, v, 0, y, W - W / 10, row, DT_RIGHT, c);
+    }
+    if (s_confirm) {
+        int y = row * 3 / 2 + ROWS * row + row / 2;
+        text(dc, "Quit the game?", 0, y, W, row, DT_CENTER, RGB(255, 255, 255));
+        text(dc, "No", 0, y + row, W / 2 - row, row, DT_RIGHT, s_yes ? RGB(200, 200, 200) : RGB(255, 210, 40));
+        text(dc, "Yes", W / 2 + row, y + row, W, row, DT_LEFT, s_yes ? RGB(255, 210, 40) : RGB(200, 200, 200));
+    } else {
+        text(dc, "A  select      B  back", 0, H - row * 3 / 2, W, row, DT_CENTER, RGB(170, 170, 170));
+    }
+    GdiFlush();
+    SelectObject(dc, oldf);
+    DeleteObject(font);
+    DeleteObject(big);
+
+    if (s_h != H || s_w != W) {
+        free(s_px);
+        s_px = (uint32_t *)malloc((size_t)W * H * 4);
+        s_w = W; s_h = H;
+    }
+    if (s_px) {
+        // GDI text on black: the brightest channel is the coverage.
+        for (i = 0; i < W * H; i++) {
+            uint32_t p = bits[i], r = (p >> 16) & 255, g = (p >> 8) & 255, bl = p & 255;
+            uint32_t cov = r > g ? (r > bl ? r : bl) : (g > bl ? g : bl);
+            uint32_t a = 230 + (25 * cov) / 255;
+            uint32_t R = cov ? (r * 255 / cov * cov + 18 * (255 - cov)) / 255 : 18;
+            uint32_t G = cov ? (g * 255 / cov * cov + 20 * (255 - cov)) / 255 : 20;
+            uint32_t B = cov ? (bl * 255 / cov * cov + 32 * (255 - cov)) / 255 : 32;
+            s_px[i] = (a << 24) | (R << 16) | (G << 8) | B;
+        }
+    }
+    SelectObject(dc, old);
+    DeleteObject(bm);
+    DeleteDC(dc);
+    s_dirty = 0;
+    *changed = 1;
+    *w = s_w; *h = s_h;
+    return s_px;
+}
diff --git a/src/video/port_menu.h b/src/video/port_menu.h
new file mode 100644
index 0000000..1efe721
--- /dev/null
+++ b/src/video/port_menu.h
@@ -0,0 +1,20 @@
+// The port menu (port_menu.c). Presenter thread only.
+#ifndef PORT_MENU_H
+#define PORT_MENU_H
+
+#include <stdint.h>
+
+// Buttons merged across every pad, from xbox_InputMenuPoll (xinput_device.c).
+enum {
+    PM_GUIDE = 1, PM_BACK = 2, PM_START = 4, PM_UP = 8, PM_DOWN = 16,
+    PM_LEFT = 32, PM_RIGHT = 64, PM_A = 128, PM_B = 256
+};
+
+// Polls the pads and advances the menu; returns 1 while it is open.
+int port_menu_update(void);
+
+// The menu as straight-alpha ARGB pixels for a screen `screen_h` pixels high.
+// *changed is set when the pixels differ from the previous call.
+const uint32_t *port_menu_image(int screen_h, int *w, int *h, int *changed);
+
+#endif
